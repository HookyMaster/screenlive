{
  "productName": "ScreenLive",
  "version": "0.2.0",
  "identifier": "app.screenlive.desktop",
  "build": { "frontendDist": "../desktop" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main", "title": "ScreenLive", "url": "prototype.html?desktop=1",
      "width": 286, "height": 330, "decorations": false, "transparent": true,
      "resizable": false, "shadow": false, "alwaysOnTop": true, "visible": false, "backgroundColor": "#00000000"
    }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["../icon.ico"] }
}
